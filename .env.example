# Sanity CMS — https://manage.sanity.io
# Server-side only; read during getStaticProps, never exposed to the client.
sanityprojectId=""
sanitydataset="production"
sanityapiVersion="2022-01-12"

# _ref of the Sanity category holding the quotes document
quotesRef=""

# Absolute site URL, used for canonical and Open Graph tags
NEXT_PUBLIC_SITE_URL="https://soundsnare.vercel.app"

# Note: do not set NODE_ENV here. Next.js manages it, and overriding it
# breaks dev/production detection.
